APP_ENV=staging
SUPABASE_URL=https://STAGING_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=STAGING_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=STAGING_SERVER_ONLY_SECRET_KEY
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@STAGING_HOST:5432/postgres?sslmode=require
ALLOWED_ORIGINS=chrome-extension://STAGING_EXTENSION_ID
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAILOR_SIGNING_KEY=GENERATE_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
