{
  "manifest_version": 3,
  "name": "auto-fill",
  "description": "Review and fill job application fields using a profile you save locally.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "background": { "service_worker": "background/index.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open auto-fill" }
}
