{
  "name": "auto-fill",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/extension"],
  "scripts": {
    "build": "npm run build -w @auto-fill/extension",
    "typecheck": "npm run typecheck -w @auto-fill/extension",
    "test": "npm run test -w @auto-fill/extension",
    "test:api": "python3 -m unittest discover -s apps/api/tests",
    "lint": "npm run lint -w @auto-fill/extension",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:api && npm run build"
  }
}
