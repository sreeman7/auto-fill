{
  "name": "auto-fill",
  "private": true,
  "version": "0.8.0",
  "workspaces": ["apps/extension"],
  "scripts": {
    "build": "npm run build -w @auto-fill/extension",
    "build:staging": "npm run build:staging -w @auto-fill/extension",
    "typecheck": "npm run typecheck -w @auto-fill/extension",
    "test": "npm run test -w @auto-fill/extension",
    "test:api": "python3 -m unittest discover -s apps/api/tests",
    "lint": "npm run lint -w @auto-fill/extension",
    "verify:release": "python3 scripts/verify_release.py",
    "package:beta": "python3 scripts/package_beta.py",
    "local": "bash scripts/run_local.sh",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:api && npm run build && npm run verify:release"
  }
}
